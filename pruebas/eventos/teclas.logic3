LOGIC3
version 3
proyecto "Eventos teclas" 320 200 1 60 3 00112233
carpetas "tiles" "maps" "trajes" "sonidos"
escena 1 "Escena 1" "" 320 200 00112233
objeto 1 "Nave" escena 1 x 10 y 10 w 16 h 16 visible 1 capa 0
  variable "pulsos" 0 0
  variable "soltados" 0 0
  variable "mantener" 0 0
  evento 1 tecla "derecha" pulsar
  evento 2 tecla "derecha" soltar
  evento 3 tecla "derecha" mantener
bloque 1 evento 1 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"pulsos\") = mi.variable(\"pulsos\") + 1\n"
bloque 2 evento 2 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"soltados\") = mi.variable(\"soltados\") + 1\n"
bloque 3 evento 3 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"mantener\") = mi.variable(\"mantener\") + 1\n"
FIN
