LOGIC3
version 3
proyecto "Eventos orden" 320 200 1 60 3 00112233
carpetas "tiles" "maps" "trajes" "sonidos"
escena 1 "Escena 1" "" 320 200 00112233
objeto 1 "Guion" escena 1 x 10 y 10 w 16 h 16 visible 1 capa 0
  variable "paso" 0 0
  variable "v_inicio" 0 0
  variable "v_foto" 0 0
  variable "v_cada" 0 0
  variable "v_pulsar" 0 0
  variable "v_soltar" 0 0
  variable "v_mantener" 0 0
  evento 1 inicio
  evento 2 fotograma
  evento 3 cada 2
  evento 4 tecla "derecha" pulsar
  evento 5 tecla "derecha" soltar
  evento 6 tecla "derecha" mantener
bloque 1 evento 1 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"paso\") = mi.variable(\"paso\") + 1\nmi.variable(\"v_inicio\") = mi.variable(\"paso\")\n"
bloque 2 evento 2 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"paso\") = mi.variable(\"paso\") + 1\nmi.variable(\"v_foto\") = mi.variable(\"paso\")\n"
bloque 3 evento 3 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"paso\") = mi.variable(\"paso\") + 1\nmi.variable(\"v_cada\") = mi.variable(\"paso\")\n"
bloque 4 evento 4 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"paso\") = mi.variable(\"paso\") + 1\nmi.variable(\"v_pulsar\") = mi.variable(\"paso\")\n"
bloque 5 evento 5 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"paso\") = mi.variable(\"paso\") + 1\nmi.variable(\"v_soltar\") = mi.variable(\"paso\")\n"
bloque 6 evento 6 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"paso\") = mi.variable(\"paso\") + 1\nmi.variable(\"v_mantener\") = mi.variable(\"paso\")\n"
FIN
