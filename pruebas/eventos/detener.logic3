LOGIC3
version 3
proyecto "Eventos detener" 320 200 1 60 3 00112233
carpetas "tiles" "maps" "trajes" "sonidos"
escena 1 "Escena 1" "" 320 200 00112233
objeto 1 "A" escena 1 x 10 y 10 w 16 h 16 visible 1 capa 0
  variable "a" 0 0
  variable "b" 0 0
  variable "c" 0 0
  evento 1 fotograma
  evento 2 tecla "derecha" pulsar
objeto 2 "B" escena 1 x 40 y 10 w 16 h 16 visible 1 capa 0
  variable "a" 0 0
  variable "b" 0 0
  variable "c" 0 0
  evento 3 fotograma
bloque 1 evento 1 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"a\") = mi.variable(\"a\") + 1\n"
bloque 2 evento 2 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"b\") = mi.variable(\"b\") + 1\ndetener_script()\n"
bloque 3 evento 3 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"c\") = mi.variable(\"c\") + 1\nsi fotograma == 4\n  detener_todo()\nfin\n"
FIN
