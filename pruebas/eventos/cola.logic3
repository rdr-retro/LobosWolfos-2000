LOGIC3
version 3
proyecto "Eventos cola" 320 200 1 60 3 00112233
carpetas "tiles" "maps" "trajes" "sonidos"
escena 1 "Escena 1" "" 320 200 00112233
objeto 1 "Buzon" escena 1 x 10 y 10 w 16 h 16 visible 1 capa 0
  variable "na" 0 0
  variable "nb" 0 0
  variable "nc" 0 0
  evento 1 fotograma
  evento 2 recibir "a"
  evento 3 recibir "b"
  evento 4 recibir "c"
bloque 1 evento 1 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "si fotograma == 2\n  enviar(\"a\")\n  enviar(\"b\")\n  enviar(\"c\")\nfin\nsi fotograma == 3\n  enviar(\"a\")\nfin\n"
bloque 2 evento 2 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"na\") = mi.variable(\"na\") + 1\nesperar 2\n"
bloque 3 evento 3 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"nb\") = mi.variable(\"nb\") + 1\n"
bloque 4 evento 4 padre 0 orden 0 tipo "codigo.lobo"
  campo "codigo" "mi.variable(\"nc\") = mi.variable(\"nc\") + 1\n"
FIN
